---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Aetherexa Tools" description="This utility page does not exist.">
  <section class="content" style="padding:90px 0 120px;text-align:center;max-width:780px">
    <p class="section-eyebrow">404 · PAGE NOT FOUND</p>
    <h1 style="font-size:clamp(44px,7vw,88px);margin:25px 0">This tool isn't here.</h1>
    <p style="color:#a7bfd4;line-height:1.7;font-size:18px">The link may have moved. Browse the available tools and continue where you left off.</p>
    <a href="/#tools" class="btn primary big" style="display:inline-flex;margin-top:25px">Browse all tools →</a>
  </section>
</Base>
